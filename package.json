{
  "name": "sdp-rat",
  "version": "0.1.0",
  "private": true,
  "description": "Repo Analysis Tool (RAT) - COMS3011A. File, directory, repository, commit-set and author metrics over git history.",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=18.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "npm run start --workspace server",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run test --workspaces --if-present",
    "verify:repo": "tsx scripts/verify-repo.ts"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "concurrently": "^9.2.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
